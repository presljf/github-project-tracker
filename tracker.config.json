{
  "$schema": "./schemas/tracker.config.schema.json",
  "trackerVersion": 1,
  "repository": "presljf/github-project-tracker",
  "project": {
    "owner": "presljf",
    "title": "Project Tracker OS",
    "number": 2
  },
  "roadmap": {
    "title": "Program roadmap",
    "body": "# Project Tracker OS \u2014 program roadmap\n\nSee issue #1.\n"
  },
  "statuses": ["Todo", "In Progress", "In Review", "Blocked", "Done"],
  "fields": {
    "Release": {
      "options": ["v1.0.0", "v1.1.0"]
    },
    "Sprint": {
      "options": ["1.0.0.1", "1.0.0.2", "1.0.0.3", "backlog", "1.1.0.1"]
    },
    "Area": {
      "options": ["docs", "ci", "code", "cross", "process"]
    },
    "Kind": {
      "options": ["feature", "fix", "ux", "spike", "test", "infra"]
    },
    "Estimate": {
      "options": ["S", "M", "L"]
    },
    "Source": {
      "options": ["Internal", "CastDeck", "Other"]
    }
  },
  "issueTypes": {
    "task": "Task",
    "bug": "Bug",
    "feature": "Feature",
    "fallback": "Use project Kind if native issue types are unavailable."
  },
  "labels": {
    "risk": ["risk:low", "risk:medium", "risk:high"],
    "process": ["plan-change", "source:downstream", "status:needs-triage"]
  },
  "releases": [
    {
      "key": "v1.0.0",
      "milestone": "v1.0.0 \u2014 Tracker OS",
      "sprints": [
        {
          "key": "1.0.0.1",
          "title": "Portable playbook + lifecycle templates",
          "estimate": "L"
        },
        {
          "key": "1.0.0.2",
          "title": "Automation toolkit + tracker workflows",
          "estimate": "M"
        },
        {
          "key": "1.0.0.3",
          "title": "Template repo + release profiles + docs QA",
          "estimate": "M"
        }
      ]
    },
    {
      "key": "v1.1.0",
      "milestone": "v1.1.0 \u2014 Tracker follow-ups",
      "sprints": [
        {
          "key": "1.1.0.1",
          "title": "Tracker follow-ups",
          "estimate": "M"
        }
      ]
    }
  ],
  "automation": {
    "defaultAssignee": "presljf",
    "branchPrefix": "task/",
    "tagPattern": "^v\\d+\\.\\d+\\.\\d+$",
    "templateRepo": "presljf/github-project-tracker",
    "templateVersion": "1.2.1",
    "inReviewMode": "manual",
    "autoAddIssues": true,
    "closeToDone": true,
    "bot": {
      "enabled": false
    }
  },
  "workflows": {
    "ci": {
      "mode": "copy",
      "requiredChecks": ["lint", "format", "test"]
    },
    "audit": {
      "mode": "advisory",
      "tokenSecret": "TRACKER_TOKEN"
    },
    "release": {
      "profile": "generic",
      "dryRun": true
    }
  },
  "feedback": {
    "upstreamRepo": "presljf/github-project-tracker",
    "issueForm": "downstream-bug.yml",
    "pinnedVersion": "1.2.1"
  },
  "governance": {
    "versioning": {
      "patch": "Compatible bug fixes",
      "minor": "Compatible features",
      "major": "Breaking changes with migration notes"
    },
    "publication": {
      "status": "private",
      "license": "MIT"
    },
    "security": {
      "contact": "GitHub private vulnerability reporting when available; otherwise SECURITY.md private channel",
      "privateVulnerabilityReporting": false
    }
  },
  "guard": {
    "transportOnly": true,
    "allow": [".github/workflows/reusable-release.yml", ".github/workflows/reusable-security.yml"]
  }
}
