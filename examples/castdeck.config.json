  "automation": {
    "defaultAssignee": "presljf",
    "branchPrefix": "task/",
    "tagPattern": "^v\\d+\\.\\d+\\.\\d+$",
    "templateRepo": "presljf/github-project-tracker",
    "templateVersion": "1.0.0",
    "inReviewMode": "manual",
    "autoAddIssues": true,
    "closeToDone": true,
    "bot": {
      "enabled": false
    }
  },
  "profiles": {
    "node": {
      "commands": {
        "lint": "npm run lint",
        "format": "npm run format:check",
        "test": "npm test",
        "e2e": "npm run test:e2e",
        "verify": "npm run verify"
      }
    }
  },
  "workflows": {
    "ci": {
      "mode": "copy",
      "requiredChecks": [
        "lint",
        "format",
        "unit",
        "web-e2e",
        "verify"
      ]
    },
    "audit": {
      "mode": "advisory",
      "tokenSecret": "TRACKER_TOKEN"
    },
    "release": {
      "profile": "macos-app-github-release",
      "dryRun": true
    }
  },
  "feedback": {
    "upstreamRepo": "presljf/github-project-tracker",
    "issueForm": "downstream-bug.yml",
    "pinnedVersion": "1.0.0"
  },
  "governance": {
    "versioning": {
      "patch": "Compatible bug fixes",
      "minor": "Compatible features",
      "major": "Breaking changes with migration notes"
    },
    "publication": {
      "status": "private",
      "license": "MIT"
    },
    "security": {
      "contact": "GitHub private vulnerability reporting when available; otherwise the maintainer's private contact in SECURITY.md",
      "privateVulnerabilityReporting": false
    }
  }
}
