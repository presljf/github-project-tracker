{
  "version": 1,
  "ignore": [
    "tests/",
    "docs/",
    ".git/",
    "node_modules/",
    "dist/",
    "coverage/"
  ],
  "rules": [
    {
      "id": "github-automation",
      "paths": [
        "scripts/adopt/cli/",
        "scripts/adopt/lib/"
      ],
      "docs": [
        "docs/REFERENCE.md",
        "docs/TASK_CLI.md",
        "docs/ADOPTION.md"
      ]
    },
    {
      "id": "docs-tooling",
      "paths": [
        "scripts/adopt/docs/"
      ],
      "docs": [
        "docs/DOCS_VALIDATION.md",
        "docs/DOCS_STYLE_GUIDE.md",
        "docs/GUARD_DISTRIBUTION.md",
        "docs/DOCS_COVERAGE.md"
      ]
    },
    {
      "id": "all-scripts",
      "paths": [
        "scripts/"
      ],
      "docs": [
        "docs/REFERENCE.md",
        "docs/HOW_TO_USE.md"
      ]
    },
    {
      "id": "workflows",
      "paths": [
        ".github/workflows/"
      ],
      "docs": [
        "docs/CI_SECURITY_PROFILE.md",
        "docs/ACTIONS_CATALOG.md",
        "docs/RELEASE_PROFILES.md"
      ]
    },
    {
      "id": "actions",
      "paths": [
        ".github/actions/"
      ],
      "docs": [
        "docs/ACTIONS_CATALOG.md",
        "docs/CI_SECURITY_PROFILE.md"
      ]
    },
    {
      "id": "issue-forms",
      "paths": [
        ".github/ISSUE_TEMPLATE/"
      ],
      "docs": [
        "docs/DOWNSTREAM_FEEDBACK.md",
        "docs/HOW_TO_USE.md"
      ]
    },
    {
      "id": "config-schema",
      "paths": [
        "schemas/",
        "tracker.config.json",
        "tracker.config.example.json",
        "examples/",
        "tracker.dependencies.example.json",
        "tracker.dependencies.json"
      ],
      "docs": [
        "docs/REFERENCE.md",
        "docs/UPGRADING.md",
        "docs/ADOPTION.md"
      ]
    },
    {
      "id": "profiles",
      "paths": [
        "profiles/"
      ],
      "docs": [
        "docs/RELEASE_PROFILES.md"
      ]
    },
    {
      "id": "package",
      "paths": [
        "package.json"
      ],
      "docs": [
        "docs/REFERENCE.md",
        "docs/UPGRADING.md"
      ]
    },
    {
      "id": "adoption-contract",
      "paths": [
        "contract/"
      ],
      "docs": [
        "docs/REFERENCE.md",
        "docs/ADOPTION.md"
      ]
    },
    {
      "id": "counts-contract",
      "paths": [
        "scripts/adopt/cli/suite-counts.mjs",
        "scripts/adopt/cli/guard-docs-counts.mjs",
        "profiles/counts/"
      ],
      "docs": [
        "docs/REFERENCE.md",
        "docs/AGENT_GUIDE.md",
        "docs/DOCS_COVERAGE.md"
      ]
    },
    {
      "id": "security-root",
      "paths": [
        "SECURITY.md"
      ],
      "docs": [
        "docs/CI_SECURITY_PROFILE.md"
      ]
    },
    {
      "id": "lint-format-config",
      "paths": [
        "eslint.config.mjs",
        "prettier.config.mjs",
        ".prettierignore",
        "package-lock.json"
      ],
      "docs": [
        "docs/REFERENCE.md",
        "docs/CI_SECURITY_PROFILE.md"
      ]
    },
    {
      "id": "git-hooks",
      "paths": [
        ".githooks/"
      ],
      "docs": [
        "docs/AGENT_GUIDE.md",
        "docs/REFERENCE.md"
      ]
    },
    {
      "id": "root-docs",
      "paths": [
        "README.md",
        "CHANGELOG.md"
      ],
      "docs": [
        "docs/README.md",
        "docs/REFERENCE.md"
      ]
    },
    {
      "id": "tooling-profile",
      "paths": [
        "profiles/node/",
        "scripts/adopt/cli/verify-tooling.mjs"
      ],
      "docs": [
        "docs/LINTING.md",
        "docs/ADOPTION.md"
      ]
    },
    {
      "id": "release-tooling",
      "paths": [
        "scripts/internal/"
      ],
      "docs": [
        "docs/REFERENCE.md",
        "docs/UPGRADING.md"
      ]
    }
  ]
}
