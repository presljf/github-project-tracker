        "audience": [
          "adopter"
        ],
        "mode": "copy",
        "header": "required",
        "title": "Bad location",
        "summary": "Copy-mode entry outside profiles/.",
        "docs": []
      }
    ]
  },
  "expect": {
    "errors": [
      "SURFACE_COPY_MODE_NOT_PROFILE"
    ]
  }
}
