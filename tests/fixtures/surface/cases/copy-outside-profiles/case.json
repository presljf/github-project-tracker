{
  "write": {
    ".github/workflows/bad-example.yml": "# COPY-MODE EXAMPLE — misplaced\nname: Bad example\n\non:\n  workflow_dispatch:\n\njobs:\n  demo:\n    runs-on: ubuntu-latest\n    steps:\n      - run: echo demo\n"
  },
  "manifest": {
    "add": [
      {
        "id": "profile:bad-location",
        "path": ".github/workflows/bad-example.yml",
