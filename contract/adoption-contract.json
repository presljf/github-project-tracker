{
  "schemaVersion": 1,
  "trackerVersion": "1.3.0",
  "repository": "presljf/github-project-tracker",
  "requiredConfig": [
    "trackerVersion",
    "repository",
    "project",
    "statuses",
    "fields",
    "releases",
    "automation.templateRepo",
    "automation.templateVersion"
  ],
  "requiredWorkflows": [
    {
      "id": "ci",
      "reusable": "presljf/github-project-tracker/.github/workflows/reusable-ci.yml"
    },
    {
      "id": "security",
      "reusable": "presljf/github-project-tracker/.github/workflows/reusable-security.yml"
    },
    {
      "id": "release",
      "reusable": "presljf/github-project-tracker/.github/workflows/reusable-release.yml"
    },
    {
      "id": "desktop-smoke",
      "reusable": "presljf/github-project-tracker/.github/workflows/reusable-desktop-smoke.yml"
    }
  ],
  "requiredProfiles": ["node"],
  "requiredDocs": ["docs/TRACKER.md"],
  "overrideManifest": "tracker.overrides.json",
  "metadata": {
    "requiredIssueTypes": ["Task", "Bug", "Feature"],
    "typeMapping": {
      "release": "Task",
      "sprint": "Task",
      "task": "Feature"
    },
    "requiredFields": ["Status", "Release", "Sprint", "Area", "Kind", "Estimate", "Source"],
    "optionalFields": {
      "Priority": ["P0", "P1", "P2", "P3"]
    },
    "forbiddenFields": [],
    "requiredOptions": {
      "Status": ["Todo", "In Progress", "In Review", "Blocked", "Done"],
      "Kind": ["feature", "fix", "ux", "spike", "test", "infra"],
      "Estimate": ["S", "M", "L"],
      "Source": ["Internal"]
    },
    "hierarchy": {
      "release": ["sprint"],
      "sprint": ["task"]
    },
    "uniqueKeys": true,
    "acceptedTitlePatterns": {
      "release": ["[Release] <version> \u2014 ..."],
      "sprint": ["[Sprint] <sprint> \u2014 ..."],
      "task": ["[<sprint>-T<nn>] ..."]
    },
    "exceptionsFile": "contract/exceptions/metadata-exceptions.json"
  },
  "tooling": {
    "eslint": "^10.14.0",
    "@eslint/js": "^10.0.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.0",
    "config": "profiles/node/eslint.config.mjs"
  }
}
