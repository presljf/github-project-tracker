{
  "name": "@project-tracker/template",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "bootstrap": "node scripts/github/bootstrap.mjs",
    "audit": "node scripts/github/audit.mjs",
    "task": "node scripts/github/task.mjs",
    "validate:config": "node scripts/github/validate-config.mjs",
    "docs:check": "node scripts/docs/check-docs.mjs",
    "rate-limit": "node scripts/github/rate-limit.mjs",
    "guard:gh": "node scripts/github/guard-gh-transport.mjs",
    "guard:scope": "node scripts/github/guard-scope.mjs",
    "guard:docs": "node scripts/docs/guard-docs.mjs",
    "merge-pr": "node scripts/github/merge-pr.mjs",
    "verify:contract": "node scripts/github/verify-contract.mjs",
    "guard:pr-close": "node scripts/github/guard-pr-close.mjs",
    "audit:post-merge": "node scripts/github/post-merge-audit.mjs",
    "gate:release": "node scripts/github/release-gate.mjs",
    "guard:deps": "node scripts/github/guard-dependencies.mjs",
    "guard:versions": "node scripts/docs/check-versions.mjs",
    "verify:checksums": "node scripts/github/verify-checksums.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"*.mjs\" \"package.json\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"*.mjs\" \"package.json\" \".github/**/*.{yml,yaml}\"",
    "verify:metadata": "node scripts/github/verify-metadata.mjs",
    "reconcile:metadata": "node scripts/github/reconcile-metadata.mjs",
    "hooks:install": "node scripts/github/install-hooks.mjs",
    "verify:tooling": "node scripts/github/verify-tooling.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.0"
  }
}
