{
  "name": "@project-tracker/template",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "bootstrap": "node scripts/adopt/cli/bootstrap.mjs",
    "audit": "node scripts/adopt/cli/audit.mjs",
    "task": "node scripts/adopt/cli/task.mjs",
    "stream": "node scripts/adopt/cli/stream.mjs",
    "field-option": "node scripts/adopt/cli/project-field-option.mjs",
    "validate:config": "node scripts/adopt/cli/validate-config.mjs",
    "docs:check": "node scripts/adopt/docs/check-docs.mjs",
    "rate-limit": "node scripts/adopt/cli/rate-limit.mjs",
    "guard:gh": "node scripts/adopt/cli/guard-gh-transport.mjs",
    "guard:scope": "node scripts/adopt/cli/guard-scope.mjs",
    "guard:docs": "node scripts/adopt/docs/guard-docs.mjs",
    "merge-pr": "node scripts/adopt/cli/merge-pr.mjs",
    "verify:contract": "node scripts/adopt/cli/verify-contract.mjs",
    "guard:pr-close": "node scripts/adopt/cli/guard-pr-close.mjs",
    "guard:local-suite": "node scripts/adopt/cli/guard-local-suite.mjs",
    "guard:docs:counts": "node scripts/adopt/cli/guard-docs-counts.mjs",
    "docs:counts:check": "node scripts/adopt/cli/suite-counts.mjs check",
    "docs:counts:update": "node scripts/adopt/cli/suite-counts.mjs record",
    "audit:post-merge": "node scripts/adopt/cli/post-merge-audit.mjs",
    "gate:release": "node scripts/adopt/cli/release-gate.mjs",
    "guard:deps": "node scripts/adopt/cli/guard-dependencies.mjs",
    "guard:versions": "node scripts/adopt/docs/check-versions.mjs",
    "verify:checksums": "node scripts/adopt/cli/verify-checksums.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"*.mjs\" \"package.json\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"*.mjs\" \"package.json\" \".github/**/*.{yml,yaml}\"",
    "verify:metadata": "node scripts/adopt/cli/verify-metadata.mjs",
    "reconcile:metadata": "node scripts/adopt/cli/reconcile-metadata.mjs",
    "reconcile:status": "node scripts/adopt/cli/reconcile-status.mjs",
    "hooks:install": "node scripts/adopt/cli/install-hooks.mjs",
    "verify:tooling": "node scripts/adopt/cli/verify-tooling.mjs",
    "verify:surface": "node scripts/internal/verify-surface.mjs",
    "release:bump": "node scripts/internal/bump-version.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.0"
  },
  "overrides": {
    "espree": "11.2.0"
  }
}
