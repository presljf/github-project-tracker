{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/presljf/github-project-tracker/schemas/tracker.config.schema.json",
  "title": "Project Tracker Config",
  "description": "Versioned configuration contract for adopting the Project Tracker OS. This schema is intentionally portable; project-specific commands/artifacts live under profiles/workflows.",
  "type": "object",
  "required": [
    "trackerVersion",
    "repository",
    "project",
    "statuses",
    "fields",
    "releases"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional path/URL to this JSON Schema."
    },
    "trackerVersion": {
      "const": 1,
      "description": "Config contract version. Bump only with a documented migration."
    },
    "workProfile": {
      "enum": [
        "product",
        "tooling"
      ],
      "description": "Enforced work lifecycle: product = Release \u2192 Sprint \u2192 Task with Release/Sprint fields (default); tooling = [Stream] container \u2192 Task with a Stream field and the tag as the version record. Absent means product."
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "description": "Adopting repository in owner/name form."
    },
    "project": {
      "type": "object",
      "required": [
        "owner",
        "title",
        "number"
      ],
      "additionalProperties": false,
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "number": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "statuses": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Project Status options in display order. Standard set: Todo, In Progress, In Review, Blocked, Done."
    },
    "fields": {
      "type": "object",
      "required": [
        "Area",
        "Kind",
        "Estimate"
      ],
      "additionalProperties": false,
      "properties": {
        "Release": {
          "type": "object",
          "required": [
            "options"
          ],
          "additionalProperties": false,
          "properties": {
            "options": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "Sprint": {
          "type": "object",
          "required": [
            "options"
          ],
          "additionalProperties": false,
          "properties": {
            "options": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "Area": {
          "type": "object",
          "required": [
            "options"
          ],
          "additionalProperties": false,
          "properties": {
            "options": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "Kind": {
          "type": "object",
          "required": [
            "options"
          ],
          "additionalProperties": false,
          "properties": {
            "options": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "Estimate": {
          "type": "object",
          "required": [
            "options"
          ],
          "additionalProperties": false,
          "properties": {
            "options": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "Source": {
          "type": "object",
          "required": [
            "options"
          ],
          "additionalProperties": false,
          "properties": {
            "options": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "Stream": {
          "type": "object",
          "required": [
            "options"
          ],
          "additionalProperties": false,
          "description": "Tooling-profile delivery container field: one option per [Stream] delivery. Optional in the product profile; required when workProfile is tooling.",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Project field name (default Stream). Override only if the project board uses another name."
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "issueTypes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task": {
          "type": "string"
        },
        "bug": {
          "type": "string"
        },
        "feature": {
          "type": "string"
        },
        "fallback": {
          "type": "string",
          "description": "Label/field fallback when native issue types are unavailable."
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "risk": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "process": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "releases": {
      "type": "array",
      "minItems": 0,
      "description": "Product-profile plan skeleton (releases \u2192 sprints \u2192 tasks). The product profile requires at least one release; tooling-profile repos may leave it empty because the tag is the version record.",
      "items": {
        "type": "object",
        "required": [
          "key",
          "milestone"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "milestone": {
            "type": "string",
            "minLength": 1
          },
          "sprints": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "key",
                "title"
              ],
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "estimate": {
                  "type": "string"
                },
                "tasks": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultAssignee": {
          "type": "string"
        },
        "branchPrefix": {
          "type": "string",
          "minLength": 1
        },
        "tagPattern": {
          "type": "string"
        },
        "templateRepo": {
          "type": "string"
        },
        "templateVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "inReviewMode": {
          "enum": [
            "manual",
            "cli",
            "auto"
          ]
        },
        "autoAddIssues": {
          "type": "boolean"
        },
        "closeToDone": {
          "type": "boolean"
        },
        "bot": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "appSlug": {
              "type": "string"
            }
          }
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "commands": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "lint": {
                  "type": "string"
                },
                "format": {
                  "type": "string"
                },
                "test": {
                  "type": "string"
                },
                "e2e": {
                  "type": "string"
                },
                "verify": {
                  "type": "string"
                },
                "build": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "workflows": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ci": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "reusable",
                "copy"
              ]
            },
            "ref": {
              "type": "string"
            },
            "requiredChecks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "commands": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "install": {
                  "type": "string"
                },
                "lint": {
                  "type": "string"
                },
                "format": {
                  "type": "string"
                },
                "test": {
                  "type": "string"
                },
                "build": {
                  "type": "string"
                }
              }
            }
          }
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "advisory",
                "required"
              ]
            },
            "tokenSecret": {
              "type": "string"
            }
          }
        },
        "release": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "profile": {
              "type": "string"
            },
            "ref": {
              "type": "string"
            },
            "dryRun": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upstreamRepo": {
          "type": "string"
        },
        "issueForm": {
          "type": "string"
        },
        "pinnedVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "securityContact": {
          "type": "string"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "versioning": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "patch": {
              "type": "string"
            },
            "minor": {
              "type": "string"
            },
            "major": {
              "type": "string"
            }
          }
        },
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "private",
                "public"
              ]
            },
            "license": {
              "type": "string"
            }
          }
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "contact": {
              "type": "string"
            },
            "privateVulnerabilityReporting": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "roadmap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string"
        }
      }
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transportOnly": {
          "type": "boolean"
        },
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiredChecks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Check-run names required by the post-merge bypass audit (GitHub check context names, e.g. 'ci / ci-gate'). Absent keeps the backwards-compatible default list; adopters set their real check names."
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional verification-suite policy. Absent means no extra policy (current behaviour).",
      "properties": {
        "remoteOnly": {
          "type": "array",
          "description": "Suites that may only run visibly on a real remote runner (GITHUB_ACTIONS=true). Hidden local mode can remain available; absent or empty means no-op.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "workflow"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9][a-z0-9-]*$",
                "description": "Stable suite id passed to the guard (lowercase letters, digits, hyphens)."
              },
              "workflow": {
                "type": "string",
                "minLength": 1,
                "description": "Remote workflow file or name that runs this suite (shown in actionable instructions)."
              },
              "prLabel": {
                "type": "string",
                "minLength": 1,
                "description": "Optional PR label that triggers the remote workflow run."
              },
              "localMode": {
                "enum": [
                  "hidden",
                  "forbidden"
                ],
                "description": "Local fallback: hidden = non-authoritative hidden local mode allowed; forbidden (default) = no local run."
              },
              "overrideEnv": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$",
                "description": "Optional env var that allows deliberate human debugging with a loud warning (agents must not use it)."
              },
              "docs": {
                "type": "string",
                "minLength": 1,
                "description": "Optional doc path/URL shown in the block/override instructions."
              }
            }
          }
        }
      }
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional docs contracts. Absent means no extra docs policy.",
      "properties": {
        "counts": {
          "type": "object",
          "required": [
            "baseline",
            "generated"
          ],
          "additionalProperties": false,
          "description": "Verified PASS/FAIL/SKIP counts contract: committed baseline + generated doc + marker-bearing current-state docs. Absent means no counts policy.",
          "properties": {
            "baseline": {
              "type": "string",
              "minLength": 1,
              "description": "Path (repo-relative) to the committed test-counts baseline JSON."
            },
            "generated": {
              "type": "string",
              "minLength": 1,
              "description": "Path (repo-relative) to the generated canonical docs/TEST_COUNTS.md."
            },
            "markers": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Current-state docs that may carry inline <!-- counts:<suite>/<mode>[/<metric>] --> markers. Historical docs are never listed here."
            },
            "inventoryCommand": {
              "type": "string",
              "minLength": 1,
              "description": "Command that produces the counted runner output (shown in drift guidance)."
            },
            "updateCommand": {
              "type": "string",
              "minLength": 1,
              "description": "Command that records new counts and regenerates the baseline/docs/markers (shown in drift guidance)."
            }
          }
        }
      }
    }
  }
}
