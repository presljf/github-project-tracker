{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/presljf/github-project-tracker/schemas/tracker.config.schema.json",
  "title": "Project Tracker Config",
  "description": "Versioned configuration contract for adopting the Project Tracker OS. This schema is intentionally portable; project-specific commands/artifacts live under profiles/workflows.",
  "type": "object",
  "required": [
    "trackerVersion",
    "repository",
    "project",
    "statuses",
    "fields",
    "releases"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional path/URL to this JSON Schema."
    },
    "trackerVersion": {
      "const": 1,
      "description": "Config contract version. Bump only with a documented migration."
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "description": "Adopting repository in owner/name form."
    },
    "project": {
      "type": "object",
      "required": [
        "owner",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "number": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "statuses": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Project Status options in display order. Standard set: Todo, In Progress, In Review, Blocked, Done."
    },
    "fields": {
      "type": "object",
      "required": [
        "Release",
        "Sprint",
        "Area",
        "Kind",
        "Estimate"
      ],
      "additionalProperties": false,
      "properties": {
        "Release": {
          "type": "object",
          "required": [
            "options"
          ],
          "additionalProperties": false,
          "properties": {
            "options": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "Sprint": {
          "type": "object",
          "required": [
            "options"
          ],
          "additionalProperties": false,
          "properties": {
            "options": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "Area": {
          "type": "object",
          "required": [
            "options"
          ],
          "additionalProperties": false,
          "properties": {
            "options": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "Kind": {
          "type": "object",
          "required": [
            "options"
          ],
          "additionalProperties": false,
          "properties": {
            "options": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "Estimate": {
          "type": "object",
          "required": [
            "options"
          ],
          "additionalProperties": false,
          "properties": {
            "options": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "Source": {
          "type": "object",
          "required": [
            "options"
          ],
          "additionalProperties": false,
          "properties": {
            "options": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "issueTypes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task": {
          "type": "string"
        },
        "bug": {
          "type": "string"
        },
        "feature": {
          "type": "string"
        },
        "fallback": {
          "type": "string",
          "description": "Label/field fallback when native issue types are unavailable."
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "risk": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "process": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "key",
          "milestone"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "milestone": {
            "type": "string",
            "minLength": 1
          },
          "sprints": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "key",
                "title"
              ],
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "estimate": {
                  "type": "string"
                },
                "tasks": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultAssignee": {
          "type": "string"
        },
        "branchPrefix": {
          "type": "string",
          "minLength": 1
        },
        "tagPattern": {
          "type": "string"
        },
        "templateRepo": {
          "type": "string"
        },
        "templateVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "inReviewMode": {
          "enum": [
            "manual",
            "cli",
            "auto"
          ]
        },
        "autoAddIssues": {
          "type": "boolean"
        },
        "closeToDone": {
          "type": "boolean"
        },
        "bot": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "appSlug": {
              "type": "string"
            }
          }
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "commands": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "lint": {
                  "type": "string"
                },
                "format": {
                  "type": "string"
                },
                "test": {
                  "type": "string"
                },
                "e2e": {
                  "type": "string"
                },
                "verify": {
                  "type": "string"
                },
                "build": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "workflows": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ci": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "reusable",
                "copy"
              ]
            },
            "ref": {
              "type": "string"
            },
            "requiredChecks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "commands": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "install": {
                  "type": "string"
                },
                "lint": {
                  "type": "string"
                },
                "format": {
                  "type": "string"
                },
                "test": {
                  "type": "string"
                },
                "build": {
                  "type": "string"
                }
              }
            }
          }
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "advisory",
                "required"
              ]
            },
            "tokenSecret": {
              "type": "string"
            }
          }
        },
        "release": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "profile": {
              "type": "string"
            },
            "ref": {
              "type": "string"
            },
            "dryRun": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upstreamRepo": {
          "type": "string"
        },
        "issueForm": {
          "type": "string"
        },
        "pinnedVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "securityContact": {
          "type": "string"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "versioning": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "patch": {
              "type": "string"
            },
            "minor": {
              "type": "string"
            },
            "major": {
              "type": "string"
            }
          }
        },
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "private",
                "public"
              ]
            },
            "license": {
              "type": "string"
            }
          }
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "contact": {
              "type": "string"
            },
            "privateVulnerabilityReporting": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "roadmap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string"
        }
      }
    }
  }
}
