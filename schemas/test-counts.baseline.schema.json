{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/presljf/github-project-tracker/schemas/test-counts.baseline.schema.json",
  "title": "Verified test counts baseline",
  "description": "Committed PASS/FAIL/SKIP baseline for the tracker counts contract ('aware and agree'). One entry per suite and mode; every non-zero skip is named and agreed, and every mode carries a review record. Generated/maintained by scripts/adopt/cli/suite-counts.mjs record.",
  "type": "object",
  "required": ["schemaVersion", "suites"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional path/URL to this JSON Schema."
    },
    "schemaVersion": {
      "const": 1
    },
    "suites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "modes"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "Stable suite id (e.g. unit, e2e, desktop-smoke)."
          },
          "modes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "mode",
                "collected",
                "passed",
                "failed",
                "skipped",
                "flaky",
                "knownSkips",
                "reviewed"
              ],
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "description": "Execution mode: remote-visible, local-hidden, offline, full, or a repo-specific mode."
                },
                "collected": {
                  "type": "integer",
                  "minimum": 0
                },
                "passed": {
                  "type": "integer",
                  "minimum": 0
                },
                "failed": {
                  "type": "integer",
                  "minimum": 0
                },
                "skipped": {
                  "type": "integer",
                  "minimum": 0
                },
                "flaky": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Must be 0: fix flakiness instead of recording it."
                },
                "knownSkips": {
                  "type": "array",
                  "description": "One named+agreed entry for every skipped test (must match skipped).",
                  "items": {
                    "type": "object",
                    "required": ["test", "reason", "coveredBy", "agreedOn"],
                    "additionalProperties": false,
                    "properties": {
                      "test": {
                        "type": "string",
                        "minLength": 1
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      },
                      "coveredBy": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Issue/PR/URL covering the skip."
                      },
                      "agreedOn": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      }
                    }
                  }
                },
                "reviewed": {
                  "type": "object",
                  "required": ["on", "by", "evidence"],
                  "additionalProperties": false,
                  "properties": {
                    "on": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "by": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
