{
  "$schema": "./schemas/tracker.config.schema.json",
  "trackerVersion": 1,
  "repository": "owner/repo",
  "project": {
    "owner": "owner",
    "title": "Project Tracker",
    "number": 1
  },
  "roadmap": {
    "title": "Program roadmap",
    "body": "# Program roadmap\n\n- Release and sprint plan of record.\n"
  },
  "statuses": [
    "Todo",
    "In Progress",
    "In Review",
    "Blocked",
    "Done"
  ],
  "fields": {
    "Release": {
      "options": [
        "v1.0.0"
      ]
    },
    "Sprint": {
      "options": [
        "1.0.0.1"
      ]
    },
    "Area": {
      "options": [
        "web",
        "api",
        "data",
        "ci",
        "docs",
        "infra"
      ]
    },
    "Kind": {
      "options": [
        "feature",
        "fix",
        "ux",
        "spike",
        "test",
        "infra"
      ]
    },
    "Estimate": {
      "options": [
        "S",
        "M",
        "L"
      ]
    },
    "Source": {
      "options": [
        "Internal",
        "Downstream"
      ]
    }
  },
  "issueTypes": {
    "task": "Task",
    "bug": "Bug",
    "feature": "Feature",
    "fallback": "Use the project Kind field and document the fallback when native issue types are unavailable."
  },
  "labels": {
    "risk": [
      "risk:low",
      "risk:medium",
      "risk:high"
    ],
    "process": [
      "plan-change",
      "source:downstream",
      "status:needs-triage"
    ]
  },
  "releases": [
    {
      "key": "v1.0.0",
      "milestone": "v1.0.0 \u2014 First release",
      "sprints": [
        {
          "key": "1.0.0.1",
          "title": "Foundation",
          "estimate": "M",
          "tasks": [
            "Example task title"
          ]
        }
      ]
    }
  ],
  "automation": {
    "defaultAssignee": "owner",
    "branchPrefix": "task/",
    "tagPattern": "^v\\d+\\.\\d+\\.\\d+$",
    "templateRepo": "owner/github-project-tracker",
    "templateVersion": "1.0.0",
    "inReviewMode": "manual",
    "autoAddIssues": true,
    "closeToDone": true,
    "bot": {
      "enabled": false
    }
  },
  "profiles": {
    "node": {
      "commands": {
        "lint": "npm run lint",
        "format": "npm run format:check",
        "test": "npm test",
        "e2e": "npm run test:e2e",
        "verify": "npm run verify",
        "build": "npm run build"
      }
    }
  },
  "workflows": {
    "ci": {
      "mode": "copy",
      "requiredChecks": [
        "lint",
        "format",
        "test"
      ],
      "commands": {
        "lint": "npm run lint",
        "format": "npm run format:check",
        "test": "npm test",
        "build": "npm run build"
      }
    },
    "audit": {
      "mode": "advisory",
      "tokenSecret": "TRACKER_TOKEN"
    },
    "release": {
      "profile": "github-release",
      "dryRun": true
    }
  },
  "feedback": {
    "upstreamRepo": "owner/github-project-tracker",
    "issueForm": "downstream-bug.yml",
    "pinnedVersion": "1.0.0",
    "securityContact": "security@example.com"
  },
  "governance": {
    "versioning": {
      "patch": "Compatible bug fixes",
      "minor": "Compatible features",
      "major": "Breaking changes with migration notes"
    },
    "publication": {
      "status": "private",
      "license": "MIT"
    },
    "security": {
      "contact": "security@example.com",
      "privateVulnerabilityReporting": false
    }
  }
}
