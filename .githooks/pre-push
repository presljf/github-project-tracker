#!/bin/sh
allow_main="${TRACKER_ALLOW_MAIN_PUSH:-}"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      if [ "$allow_main" = "1" ]; then
        echo "WARNING: direct push to $remote_ref via TRACKER_ALLOW_MAIN_PUSH=1" >&2
      else
        echo "ERROR: refusing direct push to $remote_ref; open a pull request." >&2
        status=1
      fi
      ;;
    refs/tags/v*) ;;
    refs/heads/*)
      case "$remote_ref" in
        refs/heads/task/*|refs/heads/release/*|refs/heads/hotfix/*|refs/heads/chore/*) ;;
        *)
          echo "ERROR: refusing push to unexpected branch $remote_ref; use task/* and a PR." >&2
          status=1
          ;;
      esac
      ;;
  esac
done
exit "$status"
